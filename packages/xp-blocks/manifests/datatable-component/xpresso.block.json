{
  "$schema": "https://xpresso.studio/schemas/block-1.1.json",
  "name": "datatable-component",
  "version": "0.1.0",
  "formsVocab": "1.1",
  "job": "browse",
  "contract": {
    "kind": "content",
    "exportName": "DatatableComponent",
    "sourceVariants": 7,
    "presets": 7,
    "rowsPerSource": 25
  },
  "fluid": false,
  "forms": {
    "M": { "form": "stack", "targetFloorPx": 48 },
    "TP": { "form": "grid-2", "targetFloorPx": 44 },
    "TL": { "form": "disclosure", "targetFloorPx": 44 },
    "DS": { "form": "grid-4" },
    "DW": { "form": "grid-5" }
  },
  "whyPolymorphic": "One TanStack-backed state owner preserves selection, sorting, filters and pagination while four structural projections keep 25-row data native to each device class.",
  "engine": "swap",
  "interaction": {
    "finitePagination": true,
    "selectionPersistsAcrossPages": true,
    "focusReturn": true,
    "detailOverlay": true
  },
  "tokens": ["--tap-min", "--tap-coarse", "--space-s", "--role-label"],
  "budgets": { "horizontalOverflow": "none", "mobileTargetPx": 48, "tabletTargetPx": 44 },
  "baseline": { "javascriptOff": false, "reducedMotion": true },
  "a11y": { "treeInvariant": false, "roleExemption": "Compact cards and wide tables expose the same data and state through class-native semantics." }
}
