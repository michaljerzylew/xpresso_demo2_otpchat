{
  "$schema": "https://xpresso.studio/schemas/block-1.1.json",
  "name": "snap-rail",
  "version": "0.1.0",
  "formsVocab": "1.1",
  "job": "browse",
  "contract": {
    "kind": "primitive",
    "exportName": "SnapRail"
  },
  "fluid": false,
  "engine": "css",
  "interaction": {
    "sweepDemo": "/gates/primitives?primitive=snap-rail"
  },
  "tokens": [
    "--tap-min",
    "--gap-min",
    "--space-s",
    "--role-body"
  ],
  "budgets": {
    "horizontalOverflow": "declared-scrollers-only",
    "touchTargetCoarse": 44
  },
  "baseline": {
    "javascriptOff": true,
    "reducedMotion": true
  },
  "a11y": {
    "treeInvariant": true
  },
  "forms": {
    "M": {
      "form": "rail"
    },
    "TP": {
      "form": "rail"
    },
    "TL": {
      "form": "rail"
    },
    "DS": {
      "form": "grid-4"
    },
    "DW": {
      "form": "grid-5"
    }
  },
  "whyPolymorphic": "Touch classes retain horizontal native inertia while wide classes can expose the collection at once."
}
