{
  "$schema": "https://xpresso.studio/schemas/block-1.1.json",
  "name": "field-group",
  "version": "0.1.0",
  "formsVocab": "1.1",
  "job": "act",
  "contract": {
    "kind": "primitive",
    "exportName": "FieldGroup"
  },
  "fluid": false,
  "engine": "css",
