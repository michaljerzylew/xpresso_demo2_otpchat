      "form": "sheet"
    },
    "TP": {
      "form": "sheet"
    },
    "TL": {
      "form": "dialog"
    },
    "DS": {
      "form": "dialog"
    },
    "DW": {
      "form": "dialog"
    }
  },
  "whyPolymorphic": "Confirm, pick, edit and search share one contract but receive task-appropriate containment per class."
