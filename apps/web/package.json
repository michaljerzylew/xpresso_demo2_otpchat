{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/csp-hashes.mjs && tsc -b && tsc --noEmit -p tsconfig.sw.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "bash ../../scripts/check_no_hardcoded_colors.sh && vitest run",
    "preview": "vite preview",
    "size:css": "node scripts/css-size.mjs",
    "deploy": "wrangler deploy",
    "csp:hashes": "node scripts/csp-hashes.mjs",
    "pwa:assets": "tsx scripts/generate-pwa-assets.mts",
    "test:browser:auth": "XP_BROWSER_CHANNEL=chrome node tests/auth.browser.mjs",
    "test:browser:configurator": "XP_BROWSER_CHANNEL=chrome node tests/configurator.browser.mjs",
    "test:browser:csp": "XP_BROWSER_CHANNEL=chrome node tests/csp.browser.mjs",
    "test:browser:pwa": "XP_BROWSER_CHANNEL=chrome node tests/pwa.browser.mjs",
    "test:browser:theme": "XP_BROWSER_CHANNEL=chrome node tests/theme.browser.mjs",
    "evidence": "node ../../scripts/qa/capture.mjs"
  },
  "dependencies": {
    "@xp/blocks": "workspace:*",
    "@xp/core": "workspace:*",
    "@xp/motion": "workspace:*",
    "@xp/primitives": "workspace:*",
    "@xp/runtime": "workspace:*",
    "@xp/shells": "workspace:*",
    "@xp/theme": "workspace:*",
    "katex": "^0.18.7",
    "lucide-react": "^0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/katex": "^0.16.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "1.61.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.4",
    "workbox-build": "7.4.1",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "wrangler": "4.129.0"
  }
}
